### HOMEBREW EVAL
if [[ -f "/opt/homebrew/bin/brew" ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv zsh)"
elif [[ -f "/usr/local/bin/brew" ]]; then
  eval "$(/usr/local/bin/brew shellenv zsh)"
fi

### OH-MY-ZSH CONFIGURATION
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="addyi"
# Update
zstyle ':omz:update' frequency 7 # Update frequency in days
zstyle ':omz:update' mode auto # update automatically without asking

# ssh-agend configuration
zstyle :omz:plugins:ssh-agent agent-forwarding yes
zstyle :omz:plugins:ssh-agent lazy yes

# Case-insensitive tab completion
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|[._-]=* r:|=*' 'l:|=* r:|=*'

# Custom plugins may be added to $ZSH_CUSTOM/plugins/
# Add wisely, as too many plugins slow down shell startup.
plugins=(
  git
  git-prompt
  ssh-agent
  fzf
  gradle
  aliases
  zsh-autosuggestions
  zsh-syntax-highlighting
)

source $ZSH/oh-my-zsh.sh

### HISTORY CONFIGURATION
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000
setopt SHARE_HISTORY
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_REDUCE_BLANKS
setopt HIST_VERIFY

### ENVIRONMENT & PATH CONFIGURATION
export EDITOR="micro"

# SDKMAN & Java
export SDKMAN_DIR="$HOME/.sdkman"
[[ -s "$HOME/.sdkman/bin/sdkman-init.sh" ]] && source "$HOME/.sdkman/bin/sdkman-init.sh"

# Ensure JAVA_HOME is set if SDKMAN candidate exists
if [[ -z "$JAVA_HOME" && -d "$SDKMAN_DIR/candidates/java/current" ]]; then
  export JAVA_HOME="$SDKMAN_DIR/candidates/java/current"
fi

# Android SDK
export ANDROID_HOME="$HOME/Library/Android/sdk"

# Consolidate extra PATHs (using $HOME instead of hardcoded user directories)
typeset -U path PATH  # Ensures PATH contains no duplicate entries in Zsh

path=(
  "$HOME/.local/bin"
  "$ANDROID_HOME/cmdline-tools/latest/bin"
  "$ANDROID_HOME/platform-tools"
  "$ANDROID_HOME/emulator"
  $path
)
export PATH

# FZF Search Engine (uses fd for maximum speed and gitignore respect)
if command -v fd >/dev/null 2>&1; then
  export FZF_DEFAULT_COMMAND='fd --type f --strip-cwd-prefix --hidden --exclude .git'
  export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
  export FZF_ALT_C_COMMAND='fd --type d --strip-cwd-prefix --hidden --exclude .git'
fi

### ALIASES
alias python="python3"
alias pip="pip3"
alias vim="nvim"

alias less="most"
alias more="most"

alias nano="micro"

alias l="eza -la --git --header --group-directories-first"
alias ll="eza -la --git --header --group-directories-first"
alias tree="eza --tree --level=2 --git --header --group-directories-first"

alias cat="bat --paging=never"

alias gbv="git branch -vv"

alias zshconfig="vim ~/.zshrc"
alias vimconfig="vim ~/.config/nvim/init.vim"
alias omz="vim ~/.zshrc"

alias aliases="als" # aliases omz plugin
alias a="als" # aliases omz plugin
alias afind="alias | fzf"

alias yolo='git commit -m "$(curl -s https://whatthecommit.com/index.txt)"'

alias o='open .'
